# ChemAI 三端原型 —— 服务端配置模板（示例，不含真实密钥）
# 用法：把本文件复制为 .env，填入你自己的密钥即可运行。
#      .env 已被 .gitignore 忽略，不会上传到仓库。
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
# 额度护栏：单 IP 每小时上限 / 全局每日上限（防止演示额度被刷）
RATE_PER_HOUR=20
DAILY_CAP=250
# 模型名以所用服务实际支持的标识为准；当前默认值未在本次整理中联网验证。
